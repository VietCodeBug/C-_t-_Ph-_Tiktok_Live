{
  "name": "co-ty-phi-camera-preview",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:live": "node --test tests/live-*.test.mjs tests/tiktok-adapter.test.mjs tests/state-writer.test.mjs tests/tts.test.mjs",
    "prepare:assets": "node scripts/prepare-assets.mjs",
    "dev": "npm run prepare:assets && vite --host 0.0.0.0 --port 4173",
    "build": "npm run prepare:assets && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "live": "node server/index.mjs",
    "start": "node server/index.mjs"
  },
  "dependencies": {
    "@fontsource-variable/nunito": "5.3.0",
    "msedge-tts": "2.1.1",
    "three": "0.180.0",
    "tiktok-live-connector": "2.5.0"
  },
  "devDependencies": {
    "vite": "8.3.8"
  }
}
